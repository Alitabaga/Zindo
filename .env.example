# Copiez ce fichier en ".env" puis modifiez les valeurs.
# Ce fichier .env ne doit JAMAIS être envoyé sur GitHub (il est déjà ignoré).

# Mot de passe de l'espace admin (10 caractères minimum en production)
ADMIN_PASSWORD=changez-moi-svp

# Port local (facultatif, 3000 par défaut)
# PORT=3000

# Dossier des données (base + photos). Par défaut : ./data
# DATA_DIR=./data

# En ligne uniquement : active les protections de production
# NODE_ENV=production
